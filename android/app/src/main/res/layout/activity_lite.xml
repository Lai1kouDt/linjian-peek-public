<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="22dp"
        android:paddingRight="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PALM WINDOW  ·  LITE"
            android:textColor="#FFD37091"
            android:textSize="9sp"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="掌心窗"
            android:textColor="#FF433039"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="只留下闹钟、锁屏和必要的连接。"
            android:textColor="#FF916E7B"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/liteServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="○  后台服务未启动"
                android:textColor="#FF916E7B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liteAccessibilityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="无障碍：未开启"
                android:textColor="#FF9A7583"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/liteConnectionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="填写连接信息后启动服务。"
                android:textColor="#FF9A7583"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="连接设置"
                android:textColor="#FF553742"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/liteServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="服务器地址  https://…"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="#FF433039"
                android:textColorHint="#FFB99AA5"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/liteToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Token"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="#FF433039"
                android:textColorHint="#FFB99AA5"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/liteDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="设备 ID"
                android:inputType="text"
                android:maxLines="1"
                android:text="android-phone"
                android:textColor="#FF433039"
                android:textColorHint="#FFB99AA5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/liteSaveButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/pill_soft"
                android:text="保存连接"
                android:textAllCaps="false"
                android:textColor="#FF8B5368"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="必要权限"
                android:textColor="#FF553742"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="无障碍用于锁屏与基础设备状态；不读页面文字、不截图。开启后不用一直打开本页面。"
                android:textColor="#FF9A7583"
                android:textSize="10sp" />

            <Button
                android:id="@+id/liteAccessibilityButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/pill_soft"
                android:text="打开无障碍设置"
                android:textAllCaps="false"
                android:textColor="#FF8B5368"
                android:textSize="12sp" />

            <Button
                android:id="@+id/liteBatteryButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/pill_soft"
                android:text="允许后台持续运行"
                android:textAllCaps="false"
                android:textColor="#FF8B5368"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/liteToggleButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/pill_primary"
            android:text="启动掌心窗"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/liteTestAlarmButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/pill_soft"
                android:text="测试闹钟"
                android:textAllCaps="false"
                android:textColor="#FF8B5368"
                android:textSize="11sp" />

            <Button
                android:id="@+id/liteTestLockButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/pill_soft"
                android:text="测试锁屏"
                android:textAllCaps="false"
                android:textColor="#FF8B5368"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/liteDebugButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/pill_soft"
            android:text="查看最近日志"
            android:textAllCaps="false"
            android:textColor="#FF9A7583"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="掌心窗 Lite · 只做真正用得到的事"
            android:textColor="#FFB99AA5"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
