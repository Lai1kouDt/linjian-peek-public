<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F6FBF8">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="掌心窗" android:textColor="#163E32" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="手机状态 · 截图 · 无障碍 · 原生闹钟" android:textColor="#64756F"/>
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="14dp" android:background="@drawable/card_bg"/>
<TextView android:id="@+id/phoneStateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="14dp" android:background="@drawable/card_bg"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="连接设置" android:textSize="18sp" android:textStyle="bold"/>
<EditText android:id="@+id/serverInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="服务器地址（HTTPS）" android:inputType="textUri" android:singleLine="true"/>
<EditText android:id="@+id/tokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Token" android:inputType="textPassword" android:singleLine="true"/>
<EditText android:id="@+id/deviceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="设备 ID" android:singleLine="true"/>
<EditText android:id="@+id/intervalInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="轮询间隔（毫秒）" android:inputType="number" android:singleLine="true"/>
<EditText android:id="@+id/lockPackageInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="“一键锁屏”App 包名" android:singleLine="true"/>
<Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="保存设置"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/startButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="启动服务"/>
<Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="停止服务"/></LinearLayout>
<Button android:id="@+id/connectionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="检查后端连接"/>
<Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="打开无障碍设置"/>
<Button android:id="@+id/stateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="刷新手机状态"/>
<Button android:id="@+id/screenshotButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="测试截图"/>
<Button android:id="@+id/lockButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="测试一键锁屏"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="诊断日志" android:textSize="18sp" android:textStyle="bold"/>
<TextView android:id="@+id/debugText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:padding="12dp" android:background="@drawable/card_bg" android:textIsSelectable="true" android:textSize="12sp"/>
<Button android:id="@+id/clearLogButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="清空日志"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="v0.4.0-lean" android:textColor="#81908A"/>
</LinearLayout></ScrollView>
